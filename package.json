{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun load-test/run.ts",
    "migration:up": "bun src/infrastructure/persistence/migrate.ts up",
    "migration:down": "bun src/infrastructure/persistence/migrate.ts down",
    "migration:status": "bun src/infrastructure/persistence/migrate.ts status"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.8",
    "@mikro-orm/migrations": "^7.2.8",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.8",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6",
    "typescript-eslint": "^8.72.2"
  }
}
